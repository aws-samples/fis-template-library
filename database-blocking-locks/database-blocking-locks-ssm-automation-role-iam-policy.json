{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowEC2DescribeActions",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:DescribeInstanceStatus",
                "ec2:DescribeSecurityGroups"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowRDSDescribeActions",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDBInstances",
                "rds:DescribeDBClusters"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowEC2RunInstancesTaggedInstance",
            "Effect": "Allow",
            "Action": "ec2:RunInstances",
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/FIS-Experiment": "DatabaseBlockingLocks"
                },
                "ArnEquals": {
                    "ec2:InstanceProfile": "arn:aws:iam::<YOUR AWS ACCOUNT>:instance-profile/DatabaseBlockingLocks-Instance-Profile"
                }
            }
        },
        {
            "Sid": "AllowEC2RunInstancesOtherResources",
            "Effect": "Allow",
            "Action": "ec2:RunInstances",
            "Resource": [
                "arn:aws:ec2:<YOUR REGION>::image/*",
                "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:subnet/*",
                "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:network-interface/*",
                "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:security-group/*",
                "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:volume/*"
            ]
        },
        {
            "Sid": "AllowEC2CreateTaggedSecurityGroup",
            "Effect": "Allow",
            "Action": "ec2:CreateSecurityGroup",
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:security-group/*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/FIS-Experiment": "DatabaseBlockingLocks"
                }
            }
        },
        {
            "Sid": "AllowEC2CreateSecurityGroupInVpc",
            "Effect": "Allow",
            "Action": "ec2:CreateSecurityGroup",
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:vpc/*"
        },
        {
            "Sid": "AllowEC2TagOnCreate",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "ec2:CreateAction": [
                        "RunInstances",
                        "CreateSecurityGroup"
                    ]
                }
            }
        },
        {
            "Sid": "AllowEC2InstanceManagementByTag",
            "Effect": "Allow",
            "Action": "ec2:TerminateInstances",
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/FIS-Experiment": "DatabaseBlockingLocks"
                }
            }
        },
        {
            "Sid": "AllowEC2SecurityGroupManagementByTag",
            "Effect": "Allow",
            "Action": "ec2:DeleteSecurityGroup",
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:security-group/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/FIS-Experiment": "DatabaseBlockingLocks"
                }
            }
        },
        {
            "Sid": "AllowDatabaseSecurityGroupIngress",
            "Effect": "Allow",
            "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupIngress"
            ],
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:security-group/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/FIS-Ready": "True"
                }
            }
        },
        {
            "Sid": "AllowSSMDescribeActions",
            "Effect": "Allow",
            "Action": [
                "ssm:DescribeInstanceInformation",
                "ssm:ListCommands",
                "ssm:ListCommandInvocations"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowSSMSendCommandToTaggedInstances",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ec2:<YOUR REGION>:<YOUR AWS ACCOUNT>:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/FIS-Experiment": "DatabaseBlockingLocks"
                }
            }
        },
        {
            "Sid": "AllowSSMSendCommandDocument",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ssm:<YOUR REGION>::document/AWS-RunShellScript"
        },
        {
            "Sid": "AllowSSMGetCommandInvocation",
            "Effect": "Allow",
            "Action": "ssm:GetCommandInvocation",
            "Resource": "*"
        },
        {
            "Sid": "AllowSSMDocumentAccess",
            "Effect": "Allow",
            "Action": [
                "ssm:GetDocument",
                "ssm:DescribeDocument"
            ],
            "Resource": "arn:aws:ssm:<YOUR REGION>::document/AWS-RunShellScript"
        },
        {
            "Sid": "AllowPassRoleToEC2",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/DatabaseBlockingLocks-Instance-Profile",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ec2.amazonaws.com"
                }
            }
        },
        {
            "Sid": "AllowSSMParameterAccess",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters"
            ],
            "Resource": "arn:aws:ssm:<YOUR REGION>::parameter/aws/service/ami-amazon-linux-latest/*"
        },
        {
            "Sid": "AllowReadAutomationExecutionsForLeftoverGroups",
            "Effect": "Allow",
            "Action": "ssm:GetAutomationExecution",
            "Resource": "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:automation-execution/*"
        }
    ]
}
