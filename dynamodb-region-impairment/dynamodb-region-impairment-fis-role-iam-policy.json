{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowReadTableAndStreamPolicies",
            "Effect": "Allow",
            "Action": [
                "dynamodb:DescribeTable",
                "dynamodb:GetResourcePolicy"
            ],
            "Resource": "arn:aws:dynamodb:<YOUR REGION>:<YOUR AWS ACCOUNT>:table/*"
        },
        {
            "Sid": "AllowPauseReplicationOnTargetTable",
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutResourcePolicy",
                "dynamodb:DeleteResourcePolicy"
            ],
            "Resource": [
                "arn:aws:dynamodb:<YOUR REGION>:<YOUR AWS ACCOUNT>:table/<YOUR TABLE NAME>",
                "arn:aws:dynamodb:<YOUR REGION>:<YOUR AWS ACCOUNT>:table/<YOUR TABLE NAME>/stream/*"
            ]
        },
        {
            "Sid": "AllowTargetResolution",
            "Effect": "Allow",
            "Action": [
                "tag:GetResources"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowSSMDocumentExecution",
            "Effect": "Allow",
            "Action": [
                "ssm:StartAutomationExecution",
                "ssm:GetAutomationExecution",
                "ssm:StopAutomationExecution"
            ],
            "Resource": [
                "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:document/DynamoDB-Region-Impairment",
                "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:automation-definition/DynamoDB-Region-Impairment:*",
                "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:automation-execution/*"
            ]
        },
        {
            "Sid": "AllowPassSSMAutomationRole",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/<YOUR SSM AUTOMATION ROLE NAME>",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ssm.amazonaws.com"
                }
            }
        }
    ]
}
