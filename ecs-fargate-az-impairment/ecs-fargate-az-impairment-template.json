{
    "description": "ECS Fargate AZ Impairment (fault only) - Simulates availability zone network failure with task stop, network packet loss, and AZ connectivity disruption. No control-plane changes are made to the service.",
    "roleArn": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/<YOUR ROLE NAME>",
    "actions": {
        "disrupt-az-connectivity": {
            "actionId": "aws:network:disrupt-connectivity",
            "description": "Deny intra-VPC traffic between the target subnet and subnets in other Availability Zones, simulating an AZ network partition",
            "parameters": {
                "scope": "availability-zone",
                "duration": "PT15M"
            },
            "targets": {
                "Subnets": "subnet-in-az"
            }
        },
        "inject-network-packet-loss": {
            "actionId": "aws:ecs:task-network-packet-loss",
            "description": "Injects 100% packet loss for tasks in the target availability zone",
            "parameters": {
                "duration": "PT15M",
                "lossPercent": "100",
                "sources": "0.0.0.0/0",
                "useEcsFaultInjectionEndpoints": "true"
            },
            "targets": {
                "Tasks": "ecs-tasks-for-packet-loss"
            }
        },
        "wait-before-stop": {
            "actionId": "aws:fis:wait",
            "description": "Wait 1 minute for packet loss and connectivity disruption to take effect before stopping tasks",
            "parameters": {
                "duration": "PT1M"
            }
        },
        "stop-tasks-in-az": {
            "actionId": "aws:ecs:stop-task",
            "description": "Stop all ECS Fargate tasks running in the target availability zone",
            "targets": {
                "Tasks": "ecs-tasks-for-stop"
            },
            "startAfter": ["wait-before-stop"]
        }
    },
    "stopConditions": [
        {
            "source": "none"
        }
    ],
    "targets": {
        "subnet-in-az": {
            "resourceType": "aws:ec2:subnet",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "filters": [
                {
                    "path": "AvailabilityZone",
                    "values": ["<YOUR TARGET AZ>"]
                }
            ],
            "selectionMode": "ALL"
        },
        "ecs-tasks-for-stop": {
            "resourceType": "aws:ecs:task",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "filters": [
                {
                    "path": "AvailabilityZone",
                    "values": ["<YOUR TARGET AZ>"]
                }
            ],
            "selectionMode": "ALL"
        },
        "ecs-tasks-for-packet-loss": {
            "resourceType": "aws:ecs:task",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "filters": [
                {
                    "path": "AvailabilityZone",
                    "values": ["<YOUR TARGET AZ>"]
                }
            ],
            "selectionMode": "ALL"
        }
    },
    "tags": {
        "Name": "ecs-fargate-az-impairment",
        "Purpose": "chaos-engineering",
        "Environment": "test"
    },
    "experimentOptions": {
        "accountTargeting": "single-account",
        "emptyTargetResolutionMode": "skip"
    }
}
