{
    "description": "ECS Fargate AZ Impairment (fault only) - Injects 100% egress packet loss into the FIS-Ready tasks running in the target AZ for the first minute, then stops those tasks and denies intra-VPC traffic between the target AZ's FIS-Ready subnets and the other AZs for 15 minutes. Makes no change to the ECS service's configuration.",
    "roleArn": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/<YOUR ROLE NAME>",
    "actions": {
        "disrupt-az-connectivity": {
            "actionId": "aws:network:disrupt-connectivity",
            "description": "From 1 minute after the start, deny intra-VPC traffic between the target subnets and subnets in other Availability Zones for 15 minutes, simulating an AZ network partition",
            "parameters": {
                "scope": "availability-zone",
                "duration": "PT15M"
            },
            "targets": {
                "Subnets": "subnet-in-az"
            },
            "startAfter": ["wait-before-stop"]
        },
        "inject-network-packet-loss": {
            "actionId": "aws:ecs:task-network-packet-loss",
            "description": "Injects 100% egress packet loss into the FIS-Ready tasks running in the target AZ at experiment start, for 1 minute, before the network fault starts. The AWS document keeps the ECS agent endpoint and the Region's SSM endpoints reachable. Doesn't install dependencies: the sidecar image must already have them",
            "parameters": {
                "duration": "PT1M",
                "lossPercent": "100",
                "sources": "0.0.0.0/0",
                "installDependencies": "false",
                "useEcsFaultInjectionEndpoints": "true"
            },
            "targets": {
                "Tasks": "ecs-tasks-for-packet-loss"
            }
        },
        "wait-before-stop": {
            "actionId": "aws:fis:wait",
            "description": "Wait 1 minute, while packet loss is active, before stopping the tasks and starting the network fault",
            "parameters": {
                "duration": "PT1M"
            }
        },
        "stop-tasks-in-az": {
            "actionId": "aws:ecs:stop-task",
            "description": "Stop the FIS-Ready tasks that were running in the target AZ at experiment start",
            "targets": {
                "Tasks": "ecs-tasks-for-stop"
            },
            "startAfter": ["wait-before-stop"]
        }
    },
    "stopConditions": [
        {
            "source": "none"
        }
    ],
    "targets": {
        "subnet-in-az": {
            "resourceType": "aws:ec2:subnet",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "filters": [
                {
                    "path": "AvailabilityZone",
                    "values": ["<YOUR TARGET AZ>"]
                }
            ],
            "selectionMode": "ALL"
        },
        "ecs-tasks-for-stop": {
            "resourceType": "aws:ecs:task",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "filters": [
                {
                    "path": "AvailabilityZone",
                    "values": ["<YOUR TARGET AZ>"]
                },
                {
                    "path": "LastStatus",
                    "values": ["RUNNING"]
                }
            ],
            "selectionMode": "ALL"
        },
        "ecs-tasks-for-packet-loss": {
            "resourceType": "aws:ecs:task",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "filters": [
                {
                    "path": "AvailabilityZone",
                    "values": ["<YOUR TARGET AZ>"]
                },
                {
                    "path": "LastStatus",
                    "values": ["RUNNING"]
                }
            ],
            "selectionMode": "ALL"
        }
    },
    "tags": {
        "Name": "ecs-fargate-az-impairment",
        "Purpose": "chaos-engineering",
        "Environment": "test"
    },
    "experimentOptions": {
        "accountTargeting": "single-account",
        "emptyTargetResolutionMode": "fail"
    }
}
