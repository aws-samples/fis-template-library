{
    "description": "MySQL RDS Load Test and Failover Experiment",
    "targets": {
        "LoadTestInstances": {
            "resourceType": "aws:ec2:instance",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "selectionMode": "ALL"
        },
        "MySQLInstances": {
            "resourceType": "aws:rds:db",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "selectionMode": "ALL"
        }
    },
    "actions": {
        "RunLoadTest": {
            "actionId": "aws:ssm:send-command",
            "description": "Run the MySQL load test for the whole experiment. The action's duration is longer than the document's Duration, so the action is still running if the experiment is stopped, and FIS then cancels the load",
            "parameters": {
                "documentArn": "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:document/MySQL-LoadTest-Document",
                "documentParameters": "{\"DBHost\":\"<YOUR DB ENDPOINT>\",\"DBSecretId\":\"mysql-rds-password\",\"Duration\":\"600\",\"Concurrency\":\"25\",\"TargetCPU\":\"80\"}",
                "duration": "PT11M"
            },
            "targets": {
                "Instances": "LoadTestInstances"
            }
        },
        "WaitBeforeFailover": {
            "actionId": "aws:fis:wait",
            "description": "Let the load build up for 5 minutes before the failover. Runs at the same time as RunLoadTest",
            "parameters": {
                "duration": "PT5M"
            }
        },
        "ForceFailover": {
            "actionId": "aws:rds:reboot-db-instances",
            "description": "Force a failover by rebooting the primary instance with failover",
            "parameters": {
                "forceFailover": "true"
            },
            "targets": {
                "DBInstances": "MySQLInstances"
            },
            "startAfter": ["WaitBeforeFailover"]
        },
        "StopLoadTest": {
            "actionId": "aws:ssm:send-command",
            "description": "Stop any load test worker still running when RunLoadTest ends, for example if Duration was set longer than RunLoadTest's duration",
            "parameters": {
                "documentArn": "arn:aws:ssm:<YOUR REGION>::document/AWS-RunShellScript",
                "documentParameters": "{\"commands\":[\"pkill -f 'mysql_load_worker'\",\"echo \\\"Load test stopped\\\"\"]}",
                "duration": "PT1M"
            },
            "targets": {
                "Instances": "LoadTestInstances"
            },
            "startAfter": ["RunLoadTest"]
        }
    },
    "stopConditions": [
        {
            "source": "none"
        }
    ],
    "roleArn": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/<YOUR ROLE NAME>",
    "logConfiguration": {
        "logSchemaVersion": 2,
        "cloudWatchLogsConfiguration": {
            "logGroupArn": "arn:aws:logs:<YOUR REGION>:<YOUR AWS ACCOUNT>:log-group:/aws/fis/experiment:*"
        }
    },
    "tags": {
        "Name": "MySQL-RDS-LoadTest-Failover"
    },
    "experimentOptions": {
        "accountTargeting": "single-account",
        "emptyTargetResolutionMode": "fail"
    }
}
