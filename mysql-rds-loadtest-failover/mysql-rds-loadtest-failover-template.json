{
    "description": "MySQL RDS Load Test and Failover Experiment",
    "targets": {
        "LoadTestInstances": {
            "resourceType": "aws:ec2:instance",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "selectionMode": "ALL"
        },
        "MySQLInstances": {
            "resourceType": "aws:rds:db",
            "resourceTags": {
                "FIS-Ready": "True"
            },
            "selectionMode": "ALL"
        }
    },
    "actions": {
        "RunLoadTest": {
            "actionId": "aws:ssm:send-command",
            "description": "Run the MySQL load test. The action's duration is longer than the document can run (its install and load steps time out after 120 and 1020 seconds), so the document ends while the action runs and a stop at any point cancels it",
            "parameters": {
                "documentArn": "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:document/MySQL-LoadTest-Document",
                "documentParameters": "{\"DBHost\":\"<YOUR DB ENDPOINT>\",\"DBSecretId\":\"mysql-rds-password\",\"Duration\":\"600\",\"Concurrency\":\"25\",\"TargetCPU\":\"80\"}",
                "duration": "PT25M"
            },
            "targets": {
                "Instances": "LoadTestInstances"
            }
        },
        "WaitBeforeFailover": {
            "actionId": "aws:fis:wait",
            "description": "Wait 5 minutes before the failover. Starts at the same time as RunLoadTest, whose load starts after the install and setup",
            "parameters": {
                "duration": "PT5M"
            }
        },
        "ForceFailover": {
            "actionId": "aws:rds:reboot-db-instances",
            "description": "Force a failover by rebooting the primary instance with failover",
            "parameters": {
                "forceFailover": "true"
            },
            "targets": {
                "DBInstances": "MySQLInstances"
            },
            "startAfter": ["WaitBeforeFailover"]
        }
    },
    "stopConditions": [
        {
            "source": "none"
        }
    ],
    "roleArn": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/<YOUR ROLE NAME>",
    "logConfiguration": {
        "logSchemaVersion": 2,
        "cloudWatchLogsConfiguration": {
            "logGroupArn": "arn:aws:logs:<YOUR REGION>:<YOUR AWS ACCOUNT>:log-group:/aws/fis/experiment:*"
        }
    },
    "tags": {
        "Name": "MySQL-RDS-LoadTest-Failover"
    },
    "experimentOptions": {
        "accountTargeting": "single-account",
        "emptyTargetResolutionMode": "fail"
    }
}
